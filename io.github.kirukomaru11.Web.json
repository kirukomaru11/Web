{
    "app-id" : "io.github.kirukomaru11.Web",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "web",
    "finish-args" : [ "--device=dri", "--share=network", "--socket=pulseaudio", "--socket=wayland" ],
    "cleanup": [ "/share/doc", "/share/licenses", "/lib/debug", "/lib/systemd" ],
    "modules" : [
        {
            "name": "transmission",
            "buildsystem": "cmake-ninja",
            "config-opts": [ "-DENABLE_GTK=OFF", "-DENABLE_QT=OFF", "-DENABLE_MAC=OFF", "-DENABLE_TESTS=OFF", "-DINSTALL_DOC=OFF", "-DWITH_SYSTEMD=OFF" ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/transmission/transmission",
                    "tag": "4.1.3"
                }
            ]
        },
        {
            "name" : "main",
            "buildsystem" : "simple",
            "build-commands" : [ "mv utils/* .", "env", "python ${FLATPAK_ID##*.}.py --install" ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/kirukomaru11/Web.git",
                    "branch" : "main"
                },
                {
                    "type" : "git",
                    "url" : "https://github.com/kirukomaru11/Utils.git",
                    "branch" : "main",
                    "dest" : "utils"
                }
            ]
        }
    ]
}